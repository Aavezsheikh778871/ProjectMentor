# ---------------------------------------------------------------------------
# ProjectMentor AI - server configuration
#
# The app runs with ZERO keys: no MONGODB_URI means memory-only storage,
# no AI key means the deterministic offline engine answers instead. Add
# real values below to upgrade either without changing any code.
#
# Copy this file to `.env` and fill in what you have.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Leave blank to run in memory-only mode (fine for a demo).
MONGODB_URI=

# Leave blank in development and a random secret is generated for you.
# REQUIRED in production - the server refuses to boot without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# gemini | openai | fallback. Leave blank to auto-detect from the keys below.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Ollama...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to disable rate limiting entirely (handy for demos).
DISABLE_RATE_LIMIT=false
CACHE_TTL_SECONDS=86400
